{
  "name": "maco",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discover open-source Mac apps and clearly labeled source-available alternatives.",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun run sync && bun --bun astro dev",
    "validate": "bun scripts/catalog.ts validate",
    "sync": "bun scripts/catalog.ts sync",
    "check:generated": "bun scripts/catalog.ts check",
    "build": "bun run sync && bun --bun astro build",
    "preview": "bun --bun astro preview",
    "check": "bun --bun astro check",
    "test": "bun test",
    "format": "bun --bun prettier --write src scripts tests astro.config.mjs",
    "check:links": "bun scripts/check-links.ts",
    "discover": "bun scripts/discover.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/astro": "^1.16.0",
    "astro": "^7.4.0",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.3",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3"
}
