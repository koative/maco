{
  "name": "openstore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A considered collection of open-source apps for macOS.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run sync && astro dev",
    "validate": "tsx scripts/catalog.ts validate",
    "sync": "tsx scripts/catalog.ts sync",
    "check:generated": "tsx scripts/catalog.ts check",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src scripts tests astro.config.mjs",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/astro": "^1.16.0",
    "astro": "^7.4.0",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
