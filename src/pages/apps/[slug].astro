---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/AppIcon.astro';
import AppCard from '../../components/AppCard.astro';
import Github from '../../components/GithubIcon.astro';
import { getApps } from '../../lib/catalog';
import { renderMarkdown } from '../../lib/markdown';
import {
  ArrowRight,
  ArrowUpRight,
  ShieldCheck,
  ChevronRight,
} from '@lucide/astro';
export function getStaticPaths() {
  return getApps().map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
const related = getApps()
  .filter((other) => other.category === app.category && other.slug !== app.slug)
  .slice(0, 3);
const descriptionHtml = renderMarkdown(app.body);
const verified = new Date(app.verified + 'T00:00:00Z').toLocaleDateString(
  'en-US',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);
---

<Layout
  title={`${app.name} — OpenStore`}
  description={app.summary}
  active="app"
  image={app.screenshots[0]?.url || app.iconUrl || undefined}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={base}>Discover</a>
    <ChevronRight size={12} />
    <a href={`${base}?category=${encodeURIComponent(app.category)}#catalog`}>
      {app.category}
    </a>
    <ChevronRight size={12} />
    <span aria-current="page">{app.name}</span>
  </nav>
  <header class="detail-hero">
    <AppIcon app={app} size={100} eager />
    <div class="detail-title">
      <h1>{app.name}</h1>
      <p>{app.summary}</p>
      <div class="detail-badges">
        <a
          href={`${base}?category=${encodeURIComponent(app.category)}#catalog`}
        >
          {app.category}
        </a>
        <span>
          <ShieldCheck size={13} />
          Open source
        </span>
      </div>
    </div>
    <div class="detail-actions">
      <a class="button button-dark" href={app.download}>
        Get {app.name} <ArrowUpRight size={16} />
      </a>
      <a class="button button-outline" href={app.repository}>
        <Github size={16} />
        View source
      </a>
    </div>
  </header>
  <div class="detail-columns">
    <div class="detail-content">
      <section class="detail-description">
        <h2>A closer look.</h2>
        <div class="markdown-body" set:html={descriptionHtml} />
      </section>
      {app.screenshots.length > 0 && (
        <section class="screenshots" aria-labelledby="screenshots-heading">
          <h2 id="screenshots-heading">See it in action.</h2>
          {app.screenshots.map((shot) => (
            <figure class="screenshot">
              <a
                href={shot.url}
                aria-label={`Open full-size screenshot: ${shot.alt}`}
              >
                <img
                  src={shot.url}
                  alt={shot.alt}
                  loading="lazy"
                  width="1000"
                  height="625"
                />
              </a>
              <figcaption>
                {shot.alt} · <a href={shot.source}>Image by {shot.credit}</a>
              </figcaption>
            </figure>
          ))}
        </section>
      )}
      <details class="evidence">
        <summary>Sources & image credits</summary>
        <ul>
          {app.sources.map((source) => (
            <li>
              <a href={source}>{source.replace('https://', '')}</a>
            </li>
          ))}
          {app.assets.map((asset) => (
            <li>
              <a href={asset.source}>{asset.path.split('/').pop()}</a> —{' '}
              {asset.credit}. {asset.license}.
            </li>
          ))}
        </ul>
        {app.notices.length > 0 && (
          <>
            <p>License and artwork notices</p>
            <ul>
              {app.notices.map((notice) => (
                <li>
                  <a href={notice.url}>{notice.name}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </details>
    </div>
    <aside class="app-facts" aria-label="Application details">
      <h2>The details</h2>
      <dl class="facts-list">
        <div>
          <dt>Source license</dt>
          <dd>
            <a href={app.licenseUrl}>
              {app.license}
              <ArrowUpRight size={13} />
            </a>
          </dd>
        </div>
        <div>
          <dt>Official website</dt>
          <dd>
            <a href={app.website}>
              {new URL(app.website).hostname.replace('www.', '')}
              <ArrowUpRight size={13} />
            </a>
          </dd>
        </div>
        <div>
          <dt>Source repository</dt>
          <dd>
            <a href={app.repository}>
              {app.repository.replace('https://github.com/', '')}
              <ArrowUpRight size={13} />
            </a>
          </dd>
        </div>
        <div>
          <dt>Evidence checked</dt>
          <dd>
            <time datetime={app.verified}>{verified}</time>
          </dd>
        </div>
      </dl>
      <h2>Explore more like this</h2>
      <div class="facts-tags">
        {app.tags.map((tag) => (
          <a
            class="tag"
            href={`${base}?tag=${encodeURIComponent(tag)}#catalog`}
          >
            {tag.replaceAll('-', ' ')}
          </a>
        ))}
      </div>
      <p class="facts-note">
        Downloads come directly from the project. Check its release notes for
        macOS compatibility and installation options.
      </p>
      <a
        class="text-link"
        href={`https://github.com/koative/openstore/blob/main/content/apps/${app.slug}/index.md`}
      >
        Improve this listing <ArrowUpRight size={14} />
      </a>
    </aside>
  </div>
  <section class="related">
    <div class="section-heading">
      <h2>Keep exploring.</h2>
      <a href={`${base}?category=${encodeURIComponent(app.category)}#catalog`}>
        More in {app.category} <ArrowRight size={15} />
      </a>
    </div>
    <div class="app-grid">
      {related.map((other) => (
        <AppCard app={other} />
      ))}
    </div>
  </section>
</Layout>
