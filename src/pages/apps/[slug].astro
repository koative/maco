---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/AppIcon.astro';
import AppLockup from '../../components/AppLockup.astro';
import CategoryGlyph from '../../components/CategoryGlyph.astro';
import Shelf from '../../components/Shelf.astro';
import Github from '../../components/GithubIcon.astro';
import { getApps } from '../../lib/catalog';
import { categorySlug, licenseLabel } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';
import { absoluteUrl, site } from '../../lib/site';
import { ArrowUpRight, ChevronLeft } from '@lucide/astro';
export function getStaticPaths() {
  return getApps().map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryHref = `categories/${categorySlug(app.category)}/`;
const restricted = app.sourceAvailability === 'source-available';
const related = getApps()
  .filter((other) => other.slug !== app.slug)
  .map((other) => ({
    app: other,
    score:
      (other.category === app.category ? 1 : 0) +
      other.tags.filter((tag) => app.tags.includes(tag)).length * 3,
  }))
  .filter((other) => other.score > 0)
  .sort((a, b) => b.score - a.score || a.app.name.localeCompare(b.app.name))
  .map((other) => other.app)
  .slice(0, 12);
const descriptionHtml = renderMarkdown(app.body);
const verifiedDate = new Date(`${app.verified}T00:00:00Z`);
const verified = verifiedDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const repository = new URL(app.repository);
const [owner, repo] = repository.pathname.split('/').filter(Boolean);
const hosts: Record<string, string> = {
  'github.com': 'GitHub',
  'gitlab.com': 'GitLab',
  'codeberg.org': 'Codeberg',
  'sourceforge.net': 'SourceForge',
  'bitbucket.org': 'Bitbucket',
};
const host =
  hosts[repository.hostname] ?? repository.hostname.replace(/^www\./, '');
const websiteHost = new URL(app.website).hostname.replace(/^www\./, '');
const downloadHost = new URL(app.download).hostname.replace(/^www\./, '');
---

<Layout
  title={`${app.name} for Mac — Maco`}
  description={app.summary}
  type="WebPage"
  section={categoryHref}
  image={app.screenshots[0]?.url}
  imageAlt={app.screenshots[0]?.alt}
  structuredData={[
    {
      '@type': 'SoftwareApplication',
      '@id': `${absoluteUrl(`apps/${app.slug}/`)}#app`,
      name: app.name,
      description: app.summary,
      url: absoluteUrl(`apps/${app.slug}/`),
      operatingSystem: 'macOS',
      applicationCategory: app.category,
      license: app.licenseUrl,
      downloadUrl: app.download,
      sameAs: [app.website, app.repository],
      ...(app.iconUrl ? { image: absoluteUrl(app.iconUrl) } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Discover',
          item: absoluteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: app.category,
          item: absoluteUrl(categoryHref),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: app.name,
          item: absoluteUrl(`apps/${app.slug}/`),
        },
      ],
    },
  ]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}${categoryHref}`}>
      <ChevronLeft size={16} stroke-width={2.4} />
      {app.category}
    </a>
  </nav>

  <header class="product-head">
    <AppIcon app={app} size={128} eager morph />
    <div class="product-title">
      <h1>{app.name}</h1>
      <p>{app.summary}</p>
      <div class="product-actions">
        <a
          class="button get-large"
          href={app.download}
          aria-label={`Get ${app.name} from the official download page`}
        >
          Get
        </a>
        <a class="button button-secondary" href={app.repository}>
          <Github size={16} />
          View Source
        </a>
      </div>
      <p class:list={['fine-print', { restricted }]}>
        {licenseLabel(app)} · Downloads from {downloadHost}
      </p>
    </div>
  </header>

  <dl class="info-strip">
    <div>
      <dt>License</dt>
      <dd class:list={['info-value', { long: app.license.length > 12 }]}>
        {app.license.replaceAll('-only', '')}
      </dd>
      <dd class:list={['info-caption', { restricted }]}>
        {restricted ? 'Source available' : 'Open source'}
      </dd>
    </div>
    <div>
      <dt>Category</dt>
      <dd class="info-value">
        <a href={`${base}${categoryHref}`} aria-label={app.category}>
          <CategoryGlyph category={app.category} size={30} />
        </a>
      </dd>
      <dd class="info-caption">{app.category}</dd>
    </div>
    <div>
      <dt>Source</dt>
      <dd class="info-value">{host}</dd>
      <dd class="info-caption">{owner}</dd>
    </div>
    <div>
      <dt>Verified</dt>
      <dd class="info-value">
        <time datetime={app.verified}>
          {verifiedDate.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </dd>
      <dd class="info-caption">{app.verified.slice(0, 4)}</dd>
    </div>
  </dl>

  {app.screenshots.length > 0 && (
    <Shelf id="screenshots" title="Screenshots" variant="shots">
      {app.screenshots.map((shot) => (
        <figure class="screenshot">
          <a href={shot.url}>
            <img
              src={shot.url}
              alt={shot.alt}
              loading="lazy"
              decoding="async"
              width="1000"
              height="625"
            />
            <span class="sr-only">Open full-size screenshot</span>
          </a>
          <figcaption>
            Image: <a href={shot.source}>{shot.credit}</a>
          </figcaption>
        </figure>
      ))}
    </Shelf>
  )}

  {restricted && (
    <section class="license-note" aria-labelledby="license-note-title">
      <h2 id="license-note-title">Source available, with restrictions</h2>
      <p>{app.licenseNotes}</p>
      <a href={app.licenseUrl}>
        Read the license <ArrowUpRight size={14} />
      </a>
    </section>
  )}

  <section class="section description" aria-labelledby="about-app">
    <h2 id="about-app">About {app.name}</h2>
    <div class="markdown-body" set:html={descriptionHtml} />
  </section>

  <section class="section" aria-labelledby="information">
    <h2 id="information">Information</h2>
    <dl class="information">
      <div>
        <dt>Source code</dt>
        <dd>
          <a href={app.repository}>
            {repo ? `${owner}/${repo}` : owner}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>License</dt>
        <dd>
          <a href={app.licenseUrl}>
            {app.license}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Website</dt>
        <dd>
          <a href={app.website}>
            {websiteHost}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Download</dt>
        <dd>
          <a href={app.download}>
            {downloadHost}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Category</dt>
        <dd>
          <a href={`${base}${categoryHref}`}>{app.category}</a>
        </dd>
      </div>
      <div>
        <dt>Evidence checked</dt>
        <dd>
          <time datetime={app.verified}>{verified}</time>
        </dd>
      </div>
      <div class="information-wide">
        <dt>Tags</dt>
        <dd class="tags">
          {app.tags.map((tag) => (
            <a
              class="tag"
              href={`${base}search/?tag=${encodeURIComponent(tag)}`}
            >
              {tag.replaceAll('-', ' ')}
            </a>
          ))}
        </dd>
      </div>
    </dl>
    <p class="note">
      Maco links to each project’s official download. Check its release notes
      for macOS version and Apple silicon support. The verification date records
      our license and source review, not a security audit.
    </p>
    <details class="evidence">
      <summary>Sources and image credits</summary>
      <ul>
        {app.sources.map((source) => (
          <li>
            <a href={source}>{source.replace('https://', '')}</a>
          </li>
        ))}
        {app.assets.map((asset) => (
          <li>
            <a href={asset.source}>{asset.path.split('/').pop()}</a>:{' '}
            {asset.credit}. {asset.license}.
          </li>
        ))}
      </ul>
      {app.notices.length > 0 && (
        <>
          <p>License and artwork notices</p>
          <ul>
            {app.notices.map((notice) => (
              <li>
                <a href={notice.url}>{notice.name}</a>
              </li>
            ))}
          </ul>
        </>
      )}
    </details>
    <a
      class="text-link"
      href={`${site.repository}/blob/main/content/apps/${app.slug}/index.md`}
    >
      Improve this listing <ArrowUpRight size={14} />
    </a>
  </section>

  {related.length > 0 && (
    <Shelf
      id="related"
      title="You Might Also Like"
      href={`${base}${categoryHref}`}
    >
      {related.map((other) => (
        <AppLockup app={other} />
      ))}
    </Shelf>
  )}
</Layout>
