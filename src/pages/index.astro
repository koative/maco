---
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/AppIcon.astro';
import AppLockup from '../components/AppLockup.astro';
import CategoryGlyph from '../components/CategoryGlyph.astro';
import Shelf from '../components/Shelf.astro';
import ShotCard from '../components/ShotCard.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import { ArrowUpRight } from '@lucide/astro';
import { getApps, categories } from '../lib/catalog';
import { collections, spotlights, categorySlug } from '../lib/collections';
import { site } from '../lib/site';
const apps = getApps();
const bySlug = new Map(apps.map((app) => [app.slug, app]));
const openSourceCount = apps.filter(
  (app) => app.sourceAvailability === 'open-source',
).length;
const sourceAvailable = apps.filter(
  (app) => app.sourceAvailability === 'source-available',
);
const spotlit = spotlights.flatMap((spot) => {
  const app = bySlug.get(spot.slug);
  return app?.screenshots.length ? [{ ...spot, app }] : [];
});
const inAction = apps.filter(
  (app) =>
    app.screenshots.length &&
    !spotlit.some((spot) => spot.app.slug === app.slug),
);
const base = import.meta.env.BASE_URL;
---

<Layout section="">
  <header class="page-head">
    <h1>Discover</h1>
    <p>
      {apps.length} Mac apps with published source code: {openSourceCount} open
      source, {sourceAvailable.length} source available.
    </p>
  </header>

  <Shelf id="spotlight" title="In the Spotlight" variant="spotlights">
    {spotlit.map((spot, index) => (
      <SpotlightCard
        app={spot.app}
        headline={spot.headline}
        stage={spot.stage}
        eager={index < 2}
      />
    ))}
  </Shelf>

  {collections.map((collection) => (
    <Shelf
      id={`collection-${collection.id}`}
      title={collection.name}
      subtitle={collection.description}
      href={`${base}collections/${collection.id}/`}
    >
      {collection.apps.map((slug) => {
        const app = bySlug.get(slug);
        return app && <AppLockup app={app} />;
      })}
    </Shelf>
  ))}

  <section class="section" aria-labelledby="categories-title">
    <header class="shelf-head">
      <div>
        <h2 id="categories-title">Browse by Category</h2>
      </div>
      <div class="shelf-actions">
        <a class="see-all" href={`${base}categories/`}>
          See All<span class="sr-only"> categories</span>
        </a>
      </div>
    </header>
    <ul class="category-grid">
      {categories.map((category) => (
        <li>
          <a
            class="category-tile"
            href={`${base}categories/${categorySlug(category)}/`}
          >
            <CategoryGlyph category={category} size={36} />
            <span>{category}</span>
            <span class="count">
              {apps.filter((app) => app.category === category).length}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Shelf
    id="in-action"
    title="See It in Action"
    subtitle="Real screenshots from each project."
    variant="shots"
  >
    {inAction.map((app) => (
      <ShotCard app={app} />
    ))}
  </Shelf>

  <Shelf
    id="source-available"
    title="Source Available"
    subtitle="Published code with extra license restrictions, explained on every page."
    href={`${base}search/?source=source-available`}
  >
    {sourceAvailable.map((app) => (
      <AppLockup app={app} />
    ))}
  </Shelf>

  <section class="contribute" aria-labelledby="contribute-title">
    <div class="contribute-icons" aria-hidden="true">
      {['ghostty', 'iina', 'localsend', 'zed', 'maccy'].map((slug) => {
        const app = bySlug.get(slug);
        return app && <AppIcon app={app} size={44} />;
      })}
    </div>
    <div>
      <h2 id="contribute-title">Know a great open-source Mac app?</h2>
      <p>
        Every listing is one folder of Markdown and images. Suggest an app, fix
        a link, or add a better screenshot.
      </p>
    </div>
    <div class="contribute-actions">
      <a class="button" href={`${site.repository}/issues/new?template=app.yml`}>
        Suggest an App
      </a>
      <a
        class="button button-secondary"
        href={`${site.repository}/blob/main/CONTRIBUTING.md`}
      >
        Contribution Guide <ArrowUpRight size={15} />
      </a>
    </div>
  </section>
</Layout>
<script>
  import { collections } from '../lib/collections';
  // Links shared before the store had dedicated pages used query filters on the home page.
  const params = new URLSearchParams(location.search);
  const collection = collections.find(
    (entry) => entry.id === params.get('collection'),
  );
  const base = import.meta.env.BASE_URL;
  if (collection) location.replace(`${base}collections/${collection.id}/`);
  else if (
    ['q', 'category', 'tag', 'source', 'sort'].some((key) => params.has(key))
  )
    location.replace(`${base}search/${location.search}`);
</script>
