---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import { ArrowUpRight, Box } from '@lucide/astro';
import Github from '../components/GithubIcon.astro';
import { site, absoluteUrl, serializeJsonLd } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}
const {
  title = site.title,
  description = site.description,
  active = 'explore',
  image,
  imageAlt = 'Maco — Discover open-source Mac apps',
  noindex = false,
  structuredData = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = absoluteUrl(image || 'social-card.png');
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}#website`,
    name: site.name,
    url: site.url,
    description: site.description,
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'Koative',
      url: 'https://github.com/koative',
    },
  },
  {
    '@type':
      active === 'about'
        ? 'AboutPage'
        : active === 'explore'
          ? 'CollectionPage'
          : 'WebPage',
    '@id': `${canonical.href}#webpage`,
    url: canonical.href,
    name: title,
    description,
    isPartOf: { '@id': `${site.url}#website` },
    inLanguage: 'en',
  },
  ...structuredData,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111214" />
    <meta
      name="robots"
      content={
        noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    <meta name="application-name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {!image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonical} />
    <link
      rel="sitemap"
      type="application/xml"
      href={absoluteUrl('sitemap.xml')}
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd({
          '@context': 'https://schema.org',
          '@graph': graph,
        })}
      />
    )}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href={base} aria-label="Maco home">
          <span class="brand-symbol">
            <Box size={24} stroke-width={1.7} />
          </span>
          maco<span class="brand-dot">.</span>
        </a>
        <nav class="top-links" aria-label="Main navigation">
          <a
            href={`${base}#catalog`}
            aria-current={active === 'explore' ? 'page' : undefined}
          >
            Explore
          </a>
          <a
            href={`${base}about/`}
            aria-current={active === 'about' ? 'page' : undefined}
          >
            Our story
          </a>
          <a
            class="nav-contribute"
            href="https://github.com/koative/maco/blob/main/CONTRIBUTING.md"
          >
            Contribute <ArrowUpRight size={13} />
          </a>
        </nav>
        <a
          class="github-link"
          href="https://github.com/koative/maco"
          aria-label="Maco on GitHub"
        >
          <Github size={18} />
          <span>Star on GitHub</span>
          <ArrowUpRight size={14} />
        </a>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <div>
          <a class="footer-name" href={base}>
            maco.
          </a>
          <span>Good software belongs to everyone.</span>
        </div>
        <nav aria-label="Footer">
          <a href={`${base}about/`}>About</a>
          <a href="https://github.com/koative/maco/blob/main/CONTRIBUTING.md">
            Contribute <ArrowUpRight size={13} />
          </a>
          <a href="https://github.com/koative/maco">
            Source <ArrowUpRight size={13} />
          </a>
        </nav>
        <p>
          Made with care by <a href="https://github.com/koative">Koative</a>.
          App trademarks belong to their owners.
        </p>
      </footer>
    </div>
  </body>
</html>
