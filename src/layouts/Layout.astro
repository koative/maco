---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import { ArrowUpRight, Box } from '@lucide/astro';
import Github from '../components/GithubIcon.astro';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
}
const {
  title = 'OpenStore — Open-source apps for your Mac',
  description = 'A considered collection of open-source Mac apps. Explore categories, real screenshots, source code, and license details. Find your next everyday essential.',
  active = 'explore',
  image,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111214" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href={base} aria-label="OpenStore home">
          <span class="brand-symbol">
            <Box size={24} stroke-width={1.7} />
          </span>
          openstore<span class="brand-dot">.</span>
        </a>
        <nav class="top-links" aria-label="Main navigation">
          <a
            href={`${base}#catalog`}
            aria-current={active === 'explore' ? 'page' : undefined}
          >
            Explore
          </a>
          <a
            href={`${base}about/`}
            aria-current={active === 'about' ? 'page' : undefined}
          >
            Our story
          </a>
          <a
            class="nav-contribute"
            href="https://github.com/koative/openstore/blob/main/CONTRIBUTING.md"
          >
            Contribute <ArrowUpRight size={13} />
          </a>
        </nav>
        <a
          class="github-link"
          href="https://github.com/koative/openstore"
          aria-label="OpenStore on GitHub"
        >
          <Github size={18} />
          <span>Star on GitHub</span>
          <ArrowUpRight size={14} />
        </a>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <div>
          <a class="footer-name" href={base}>
            openstore.
          </a>
          <span>Good software belongs to everyone.</span>
        </div>
        <nav aria-label="Footer">
          <a href={`${base}about/`}>About</a>
          <a href="https://github.com/koative/openstore/blob/main/CONTRIBUTING.md">
            Contribute <ArrowUpRight size={13} />
          </a>
          <a href="https://github.com/koative/openstore">
            Source <ArrowUpRight size={13} />
          </a>
        </nav>
        <p>
          Made with care by <a href="https://github.com/koative">Koative</a>.
          App trademarks belong to their owners.
        </p>
      </footer>
    </div>
  </body>
</html>
